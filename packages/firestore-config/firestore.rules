rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mirrors USERNAME_PATTERN in packages/models/src/v1_username.ts — rules
    // cannot import JavaScript, so the two are changed together: lowercase
    // letters, digits, dot and underscore, 3 to 20 characters, opening and
    // closing on an alphanumeric.
    function USERNAME_PATTERN() {
      return '^[a-z0-9][a-z0-9._]{1,18}[a-z0-9]$';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(user_id) {
      return isAuthenticated() && request.auth.uid == user_id;
    }

    // Admins have full access. Every collection-level
    // rule below only needs to describe the mobile app's access.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Questions are proposed by users and moderated in the backoffice
    // (docs/prd.md §4.7). An author only ever reads back their own proposals,
    // the pot in moderation stays private, and only a moderator can change a
    // question's status.
    match /v1_questions/{question_id} {
      // Two ways to read a question: it is yours, or it has already dropped as
      // the daily question — the app reads `v1_daily_question_months/{YYYY-MM}`
      // to learn which question ran a day, then this document for the label,
      // the options and the running `answer_counts`.
      //
      // Gated on the broadcast instant rather than `status == 'used'`. The two
      // coincide today — a question is drawn and published in the same 07:00
      // run — but `used` only says a question left the pot, not that it
      // reached anyone: it is the flag the scheduler happens to set, while
      // `broadcast_at` is the fact this rule is about.
      allow read: if isOwner(resource.data.author_id)
                  || (isAuthenticated()
                      && resource.data.broadcast_at != null
                      && request.time >= resource.data.broadcast_at);

      // A third way in, and the only rule in this file that grants anything
      // **without a session**: the sample question the onboarding carousel
      // poses before sign-up (`DEMO_QUESTION_ID` in packages/models). It
      // belongs to nobody and was never broadcast, so neither clause above
      // reaches it, and the visitor reading it has no account yet.
      //
      // The anonymity stops there. `get` and never `list`, so the pot stays as
      // private as it is above — one document, by its fixed id, nothing else —
      // and the answer rule below still wants an owner: the pick made in the
      // carousel waits on the phone and is written once the visitor signs up.
      allow get: if resource.data.status == 'demo';

      // **Nobody creates a question from a client any more.** An author used to
      // write their own `pending` proposal here, which was fine while proposing
      // was free: docs/prd.md §4.7 now prices it at `QUESTION_STATFLOUZZ_COST`,
      // and a price a direct write walks around is not a price. The wallet it
      // debits is already closed to the client (`keepsWallet()` below), so
      // leaving this open would have been the one hole left — pay nothing,
      // write the question anyway.
      //
      // `questions-proposeQuestion` is the door instead: it debits the profile
      // and writes the question in one transaction, admin-side, past this rule.
      // Which is also what retired the `authorUsernameIsTheirs()` check that
      // stood here — the callable reads the handle off the very profile it
      // debits, so there is no client-supplied copy left to check against the
      // reservation.
      //
      // The moderation console is unaffected: it writes through the `isAdmin()`
      // wildcard at the top of this file, and rules are OR'ed — `if false` here
      // means "the app never", not "nobody".
      allow create: if false;
      allow update, delete: if false;

      // One answer per person per broadcast question, and the document id is
      // that person's UID — so "already answered" is a property of the path,
      // not a check to run. A second answer is a write to an existing document,
      // so it is an `update`, denied below; the answer trigger can never
      // double-count `answer_counts`.
      //
      // Any signed-in user reads them: the day screen lists the friends who
      // answered and what they picked (docs/prd.md §4.5). Reading is scoped to
      // one question at a time — one question is one day — which is the whole
      // point of storing answers here rather than under the author: nobody gets
      // a friend's full history.
      //
      // `date` is checked against the question's own `broadcast_on` and `late`
      // against its `closes_at`, so neither can be forged: a catch-up answer
      // cannot be passed off as an on-time one to keep a streak alive
      // (docs/prd.md §4.6), and the answer trigger can trust both when it
      // projects the day into `v1_user_calendar_months` and moves the streak.
      // A question that was never broadcast has a null `broadcast_on`, which no
      // `date` string can equal — so nobody gets to seed answers on the
      // moderation pot, and a document predating those fields comes to the same
      // thing without erroring on the way. The onboarding demo is the one
      // question answerable without a broadcast, and it is let through by its
      // status rather than by a hole in that check — see `isAnswerToDemo` below.
      //
      // An answer is final for whoever wrote it: no update, no delete
      // (docs/prd.md §4.2). The answer trigger does write to it once, to stamp
      // `counted_at` in the transaction that folds the answer into
      // `answer_counts` — the admin SDK goes past these rules, and that stamp
      // is what tells the day screen whether the tally it read already carries
      // this answer. No client path can produce it: a create that pre-fills it
      // is refused below, and an update is refused outright. Deleting
      // an account is what removes one, backend-side (`users-deleteAccount`) —
      // and since the document id *is* its author's UID, the delete is what
      // anonymising means: there is no field left to blank. The question's
      // `answer_counts` are not decremented, so the answer keeps counting in
      // the aggregate while belonging to nobody (docs/prd.md §4.1).
      match /v1_daily_question_answers/{user_id} {
        // What every answer looks like, whatever it answers. `counted_at` is
        // the answer trigger's own marker, so a client never writes one: a
        // pre-filled one would tell the trigger this answer was already folded
        // into `answer_counts`.
        //
        // Read through `get()` with a default rather than directly, the same
        // way `keepsBackendCounters()` reads the profile's counters below: the
        // field was added after the app shipped, and a build that predates it
        // sends an answer without it. A missing-field access errors, and an
        // erroring expression denies the whole write — so checking it directly
        // would lock every installed build out of answering. Absent and `null`
        // mean the same thing here, which is what the trigger reads back.
        function hasAnswerShape() {
          return request.resource.data.user_id == user_id
                 && request.resource.data.question_id == question_id
                 && request.resource.data.option_id is string
                 && request.resource.data.option_id.size() > 0
                 && request.resource.data.answered_at is timestamp
                 && request.resource.data.get('counted_at', null) == null;
        }

        // An answer to the question as the day it ran.
        //
        // The parent's fields are read through `get()` with a default, the
        // same way `hasAnswerShape()` reads `counted_at` above: `broadcast_on`
        // and `closes_at` were added to the model after the first questions
        // were written, a missing-field access errors, and an erroring
        // expression denies the whole write. A question that has none of them
        // was never a day, which is exactly what this function should answer
        // — `false`, not an error.
        //
        // `broadcast_at` and `closes_at` are checked for presence before being
        // compared to `request.time`, because comparing an instant to a null
        // errors too. A broadcast question always carries both: the scheduler
        // stamps them in one batch.
        function isAnswerToBroadcast(question) {
          return question.get('broadcast_at', null) != null
                 && question.get('closes_at', null) != null
                 && request.time >= question.broadcast_at
                 && request.resource.data.date == question.get('broadcast_on', null)
                 && request.resource.data.late == (request.time > question.closes_at);
        }

        // An answer to the onboarding sample (docs/prd.md §5.6), which was
        // never a day: no `broadcast_on` to be dated with and no `closes_at` to
        // be late against, so both are pinned to a value that cannot be
        // mistaken for a day of anybody's calendar or streak. The trigger reads
        // the same status and folds this answer into `answer_counts` alone.
        function isAnswerToDemo(question) {
          return question.get('status', '') == 'demo'
                 && request.resource.data.date == ''
                 && request.resource.data.late == false;
        }

        // Takes the parent question rather than reading it itself, so the whole
        // rule costs one `get()` however many of its fields it checks.
        //
        // The demo is tried first, and not for taste: it is decided on `status`
        // alone, the one field every question has carried since the collection
        // existed. Whatever the broadcast branch may trip over on an older
        // document, it is never what stands between a visitor and the sample
        // question they just answered.
        function isAnswerTo(question) {
          return hasAnswerShape()
                 && (isAnswerToDemo(question) || isAnswerToBroadcast(question));
        }

        allow read: if isAuthenticated();
        allow create: if isOwner(user_id)
                      && isAnswerTo(get(/databases/$(database)/documents/v1_questions/$(question_id)).data);
        allow update, delete: if false;
      }
    }

    // A profile document is keyed by the account's Firebase Auth UID
    // (docs/prd.md §2). Any signed-in user reads any profile: a friend list
    // shows pseudos and avatars. Only the owner writes their own, and only the
    // backend (admin) deletes one, so account deletion also anonymises the
    // answers and drops the friendships in one pass. `email` and
    // `auth_providers` mirror Firebase Auth, which stays the source of truth:
    // they are only ever written by their own owner, at sign-in.
    match /v1_users/{user_id} {
      function isValidProfile() {
        return request.resource.data.username is string
               && request.resource.data.username.matches(USERNAME_PATTERN())
               && (request.resource.data.email == null || request.resource.data.email is string)
               && request.resource.data.auth_providers is list;
      }

      // The reservation below is the authority on who holds a username, so the
      // copy carried here has to agree with it. A username that was never
      // reserved has no document, so this expression errors and the write is
      // denied — which is the point: the profile field can't be forged.
      function ownsUsername() {
        return get(
          /databases/$(database)/documents/v1_usernames/$(request.resource.data.username)
        ).data.user_id == user_id;
      }

      // Streak, record and answered-days counters belong to the answer trigger
      // (docs/prd.md §4.6). The app seeds them at sign-up and never touches
      // them again, so an update that moves one is a forged score. Read
      // through `get()` with a default rather than directly: a profile written
      // before these fields existed has none, and a missing-field access
      // denies the whole write.
      function keepsBackendCounters() {
        return request.resource.data.get('streak_count', 0) == resource.data.get('streak_count', 0)
               && request.resource.data.get('streak_best', 0) == resource.data.get('streak_best', 0)
               && request.resource.data.get('answers_count', 0) == resource.data.get('answers_count', 0)
               && request.resource.data.get('streak_last_answered_on', null) == resource.data.get('streak_last_answered_on', null)
               && keepsWallet();
      }

      // The wallet (docs/prd.md §4.7) is the same deal as the counters above,
      // and a stricter one: those are a score, this is what a question is paid
      // with. The answer trigger credits it at every streak milestone and the
      // proposal callable debits it — both admin-side, past these rules — so
      // every client-side move of it is a forged balance.
      function keepsWallet() {
        return request.resource.data.get('statcoin_balance', 0) == resource.data.get('statcoin_balance', 0)
               && request.resource.data.get('statcoins_earned', 0) == resource.data.get('statcoins_earned', 0)
               && request.resource.data.get('statcoins_spent', 0) == resource.data.get('statcoins_spent', 0);
      }

      // A new profile opens empty, and that is checked rather than assumed:
      // `keepsBackendCounters()` only guards an *update*, so without this a
      // client could simply create its own profile with a balance already in
      // it — a free question, and no write to undo it afterwards.
      //
      // The streak is pinned here too, and not for symmetry: the payout is
      // computed from `streak_count` and `streak_last_answered_on`, so a
      // profile created with a streak of 9 answered yesterday is worth 100
      // StatFlouzz tomorrow. Forging a score was vanity; forging it is now
      // counterfeiting.
      //
      // `create` only ever fires on a document that does not exist, so nothing
      // written before these fields can be caught by it — completing a profile
      // that predates a username is a `set` over an existing document, which
      // is an update and goes through `keepsBackendCounters()` instead.
      function startsEmpty() {
        return request.resource.data.get('streak_count', 0) == 0
               && request.resource.data.get('streak_best', 0) == 0
               && request.resource.data.get('answers_count', 0) == 0
               && request.resource.data.get('streak_last_answered_on', null) == null
               && request.resource.data.get('statcoin_balance', 0) == 0
               && request.resource.data.get('statcoins_earned', 0) == 0
               && request.resource.data.get('statcoins_spent', 0) == 0;
      }

      allow read: if isAuthenticated();
      allow create: if isOwner(user_id) && isValidProfile() && ownsUsername() && startsEmpty();
      allow update: if isOwner(user_id)
                    && isValidProfile()
                    && ownsUsername()
                    && keepsBackendCounters()
                    && request.resource.data.created_at == resource.data.created_at;
      allow delete: if false;

      // The Stats calendar's own half of the month: the days this user
      // answered, one document per month (docs/prd.md §5.2). Private — unlike
      // the profile above, which any signed-in user reads for a friend list —
      // and written only by the answer trigger, admin-side through the
      // wildcard at the top. Reading it is what replaced a month-wide
      // collection-group query over the answers.
      match /v1_user_calendar_months/{month} {
        allow read: if isOwner(user_id);
        allow write: if false;
      }

      // Where a push lands: one document per install, keyed by the Expo push
      // token itself (docs/prd.md §4.2). Re-registering the same install is
      // then a write to the same document rather than a duplicate, the same
      // way `v1_usernames` makes uniqueness a property of the path.
      //
      // Private to its owner in every direction, and there is deliberately no
      // collection-group block for it: the only reader of everybody's tokens
      // is the daily fan-out, which runs admin-side through the wildcard at
      // the top. Deleting is the owner's too — signing out drops the token,
      // otherwise the account would keep pushing to a phone somebody else now
      // holds.
      //
      // The token's own shape is not checked here: a malformed one is filtered
      // out by the fan-out (`isExpoPushToken`) before it can poison the batch
      // it travels in, and rules cannot import the pattern the model carries.
      match /v1_user_devices/{push_token} {
        function isValidDevice() {
          return request.resource.data.user_id == user_id
                 && request.resource.data.push_token == push_token
                 && request.resource.data.platform in [ 'ios', 'android' ];
        }

        allow read: if isOwner(user_id);
        allow create, update: if isOwner(user_id) && isValidDevice();
        allow delete: if isOwner(user_id);
      }

      // One half of a friendship, keyed by the *other* user's UID
      // (docs/prd.md §4.1). A friendship is reciprocal, and it is stored as two
      // documents — one under each user — both written from the moment the
      // invitation is sent, so the invitee sees it in their own list without a
      // collection-group query nobody could be allowed to run.
      //
      // Reading is the owner's alone: a friend list is private, and it is the
      // only place the app can learn who is friends with whom.
      //
      // Writing is open to *both* sides of the pair — `isOwner(user_id)` for
      // the entry in one's own list, `isOwner(friend_id)` for the entry that
      // carries one's own UID as its id — which is exactly the two halves the
      // acting client writes in a single batch. Nothing wider: the id being the
      // friend's UID is what keeps a signed-in user out of a friendship they
      // are not part of.
      match /v1_user_friends/{friend_id} {
        function isPartOfPair() {
          return isOwner(user_id) || isOwner(friend_id);
        }

        // The handle carried on the entry is a copy of the friend's, kept so a
        // friend list costs one collection read instead of one profile read per
        // line. The reservation is the authority on who holds a handle, so the
        // copy has to agree with it — same `get()` the profile's own
        // `ownsUsername()` runs. Without this check the inviter, who writes the
        // entry landing in the invitee's list, could introduce themselves under
        // somebody else's handle. A handle that was never reserved has no
        // document, so this expression errors and the write is denied.
        function friendUsernameIsTheirs() {
          return get(
            /databases/$(database)/documents/v1_usernames/$(request.resource.data.friend_username)
          ).data.user_id == friend_id;
        }

        // The two halves mirror each other, so both carry the same shape: the
        // ids match the path they sit on, and `requested_by` is one of them.
        function isValidHalf() {
          return request.resource.data.user_id == user_id
                 && request.resource.data.friend_id == friend_id
                 && user_id != friend_id
                 && (request.resource.data.requested_by == user_id
                     || request.resource.data.requested_by == friend_id)
                 && friendUsernameIsTheirs();
        }

        allow read: if isOwner(user_id);

        // An invitation always starts pending, and always from its sender: a
        // client cannot forge an invitation it claims to have received, which
        // is what would otherwise let it accept its own — see the `update`
        // below.
        allow create: if isPartOfPair()
                      && isValidHalf()
                      && request.resource.data.status == 'pending'
                      && request.resource.data.requested_by == request.auth.uid
                      && request.resource.data.accepted_at == null;

        // Accepting, and nothing else: a half only ever moves from `pending` to
        // `accepted`, never back, and never by whoever sent the invitation.
        // Removing a friend and refusing an invitation are the same operation,
        // handled by `delete` below.
        allow update: if isPartOfPair()
                      && isValidHalf()
                      && resource.data.status == 'pending'
                      && request.resource.data.status == 'accepted'
                      && request.resource.data.requested_by == resource.data.requested_by
                      && request.resource.data.requested_by != request.auth.uid
                      && request.resource.data.created_at == resource.data.created_at
                      && request.resource.data.accepted_at is timestamp;

        // Refusing an invitation, cancelling one's own, and removing a friend:
        // the same delete, of both halves, from either side of the pair
        // (docs/prd.md §4.1 — the friendship disappears on both sides). A
        // refused invitation leaves nothing behind, so the sender is never
        // shown a "declined" state and re-inviting later starts over.
        allow delete: if isPartOfPair();
      }
    }

    // The other half of the calendar: which days actually had a question, one
    // document per month, the same one for everybody (docs/prd.md §5.2).
    //
    // Every signed-in user reads it — it holds nothing personal, only the
    // question broadcast each day — and it is what lets the app tell a missed
    // day from a day that never had a question. It is also the only mapping
    // from a day to its question: there is no per-day document, so this is
    // where reading today's question starts. Written by the daily scheduler, in
    // the same batch that stamps the question it points at.
    match /v1_daily_question_months/{month} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // One document per taken username, keyed by the username itself
    // (docs/prd.md §4.1). Uniqueness is a property of the path rather than a
    // check to run: Firestore denies a `create` on a document that already
    // exists, so two people racing for the same handle cannot both win — no
    // query, no transaction, no race.
    //
    // `get` is open to any signed-in user, because that is how a handle
    // resolves to an account when a friend is added by username; `list` is not,
    // so nobody browses the directory (docs/prd.md §4.1 forbids public user
    // search — knowing the exact handle stays the price of entry).
    match /v1_usernames/{username} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isOwner(request.resource.data.user_id)
                    && username.matches(USERNAME_PATTERN());
      // The owner rewrites their own reservation — a retry after a failed
      // profile write — but a reservation never changes hands.
      allow update: if isOwner(resource.data.user_id)
                    && request.resource.data.user_id == resource.data.user_id;
      // Freeing a username is the backend's job, alongside account deletion.
      allow delete: if false;
    }

    // A user reading their own answers across days, as a collection-group
    // query. The Stats calendar no longer runs one — it reads the two monthly
    // documents instead — but this is the query the projection is derived
    // from, and the one a rebuild or an export replays. A nested match never
    // applies to a collection group — that needs a recursive wildcard — so
    // this block is what makes it legal, on top of the per-question rule above.
    //
    // A collection group is keyed by the last path segment alone, which is why
    // the sub-collection is named `v1_daily_question_answers` and not `answers`:
    // this block would otherwise reach into every other `answers` sub-collection
    // the model grows later.
    //
    // Scoped to the caller's own answers, and deliberately not to the document
    // id: Firestore only accepts a query it can prove safe, and the calendar
    // filters on the `user_id` field. Anything broader is rejected outright, so
    // nobody can group-query their way into a friend's history — reading a
    // friend's answer stays a per-question read.
    match /{path=**}/v1_daily_question_answers/{user_id} {
      allow read: if isOwner(resource.data.user_id);
    }

    // Add the other v1_* collection rules here as the data model is designed.
  }
}
