# Firebase web app config (public — safe to embed in the SPA bundle).
# VITE_* vars are inlined at build time; read via import.meta.env in src/lib/firebase.ts.
# `.env.local` feeds `npm run dev:admin`; the deploy build (`npm run deploy:admin`) reads
# `.env.production.local` first — gitignored by `*.local` — so a deploy never ships dev values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set both to point the interface at the local Firestore emulator (apps/functions) — ports from firebase.json.
# Ignored outside `vite dev`: firebase.ts only wires the emulators when import.meta.env.DEV.
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=

# Same for the Auth emulator.
VITE_FIREBASE_AUTH_EMULATOR_HOST=
VITE_FIREBASE_AUTH_EMULATOR_PORT=
