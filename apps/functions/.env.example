# Environment of the deployed functions and of the emulator.
#
# Firebase reads these from `firebase.json`'s `configDir` (this directory) and
# NOT from the `source` directory, which is the generated `dist/` and is wiped
# by every build. Copy the ones you need:
#
#   .env                    every project
#   .env.statowrel-app      that project alone
#   .env.local              the emulator alone, never deployed
#
# All of them are gitignored except this example. **A credential never goes in
# one of these files** — it goes in Secret Manager, as a `defineSecret`:
#
#   firebase functions:secrets:set RESEND_API_KEY

# Sender of the 08:00 moderation digest — `src/domains/notifications/helpers/resendEmail.ts`.
# Unset, it falls back to Resend's shared `onboarding@resend.dev`, which only
# delivers to the address the Resend account was opened with. Set it to an
# address on a domain verified in the Resend dashboard.
RESEND_FROM="StatOwrel <notifications@exemple.fr>"

# Only needed once "enhanced security for push notifications" is turned on for
# the Expo account; unset, Expo accepts the request unauthenticated.
EXPO_ACCESS_TOKEN=

# `.env.local` only — makes the answer trigger sit on an answer that long before
# counting it, so the app's "not counted yet" branch is reachable on the
# emulator, which otherwise runs the trigger in milliseconds. Never deployed.
# ANSWER_TRIGGER_DELAY_MS=4000
