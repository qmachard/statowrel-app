# Firebase Functions v2 params — consumed by defineString() in src/libs/firebase-admin.ts.
#
# The Firebase CLI loads, in order: .env, .env.<projectId>, and .env.local (emulator only).
# Create .env.statowrel-dev / .env.statowrel-prod for per-project deploy values — all of
# them are gitignored, only this template is tracked.
#
# NEVER commit a filled-in copy: CUSTOM_FIREBASE_PRIVATE_KEY is a real credential.

CUSTOM_FIREBASE_PROJECT_ID=

# Service account client email (…@<project>.iam.gserviceaccount.com).
CUSTOM_FIREBASE_CLIENT_EMAIL=

# Base64 of the service account's `private_key` field (the PEM block, newlines included).
# Generate it from a downloaded service account JSON:
#   node -p "Buffer.from(require('./serviceAccount.json').private_key).toString('base64')"
CUSTOM_FIREBASE_PRIVATE_KEY=
