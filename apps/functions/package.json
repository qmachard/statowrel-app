{
  "name": "@statowrel/functions",
  "scripts": {
    "clean": "rm -rf lib",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "build": "npm run clean && tsc && tsc-alias",
    "build:watch": "concurrently \"tsc -w\" \"tsc-alias -w\"",
    "start:emulators": "firebase emulators:start --only functions,firestore,auth,storage --export-on-exit=./.firebase-emulator --import=./.firebase-emulator",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions -f",
    "logs": "firebase functions:log",
    "set-admin": "node scripts/set-admin.mjs",
    "dev": "NODE_ENV=development concurrently --kill-others \"npm run start:emulators\" \"npm run build:watch\""
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@statowrel/models": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "concurrently": "^9.0.1",
    "dotenv": "^16.6.1",
    "eslint": "^10.8.0",
    "globals": "^16.4.0",
    "tsc-alias": "~1.8.17",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.65.0"
  },
  "private": true
}
