{
  "name": "@statowrel/functions",
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "build": "npm run clean && node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "start:emulators": "firebase emulators:start --only functions,firestore,auth,storage --export-on-exit=./.firebase-emulator --import=./.firebase-emulator",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions -f",
    "logs": "firebase functions:log",
    "set-admin": "node scripts/set-admin.mjs",
    "seed-questions": "node scripts/seed-questions.mjs",
    "seed-daily-questions": "node scripts/seed-daily-questions.mjs",
    "dev": "npm run build && NODE_ENV=development NODE_OPTIONS=--enable-source-maps concurrently --kill-others \"npm run start:emulators\" \"npm run build:watch\""
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@statowrel/models": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "concurrently": "^9.0.1",
    "dotenv": "^16.6.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.0",
    "firebase": "^12.18.0",
    "globals": "^16.4.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.65.0"
  },
  "private": true
}
