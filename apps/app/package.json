{
  "name": "@statowrel/app",
  "private": true,
  "version": "1.0.2",
  "main": "index.js",
  "scripts": {
    "dev": "APP_VARIANT=development expo start",
    "dev:ios": "APP_VARIANT=development expo start --ios",
    "dev:android": "APP_VARIANT=development expo start --android",
    "prebuild": "APP_VARIANT=development expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "eas-build-post-install": "cd ../.. && npm run build:models",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "submit:prod:ios": "APP_VARIANT=production eas submit --profile production --platform ios",
    "submit:prod:android": "APP_VARIANT=production eas submit --profile production --platform android",
    "submit:prod": "npm run submit:prod:ios && npm run submit:prod:android"
  },
  "dependencies": {
    "@expo-google-fonts/archivo-black": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.3.2",
    "@react-native-firebase/auth": "^26.3.2",
    "@react-native-firebase/firestore": "^26.3.2",
    "@react-native-firebase/functions": "^26.3.2",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@statowrel/models": "*",
    "expo": "~57.0.14",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.13",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "lottie-react-native": "~7.3.8",
    "lucide-react-native": "^1.32.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.18",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "^5.4.5"
  }
}
