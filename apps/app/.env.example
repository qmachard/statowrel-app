# Firebase client SDK config (public — safe to embed in the app bundle).
# EXPO_PUBLIC_* vars are inlined at build time; read via process.env in code.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in (public OAuth client identifiers, not secrets).
# Copy them from the Firebase console → Authentication → Google, or from the
# GCP OAuth clients of the Firebase project.
#   WEB_CLIENT_ID   — required: the id token Firebase accepts is minted for it.
#   IOS_CLIENT_ID   — the iOS OAuth client.
#   IOS_URL_SCHEME  — the iOS client id reversed (com.googleusercontent.apps.…).
#                     Read by app.config.ts at build time, not at runtime.
# Leave them empty to ship without Google sign-in — the button hides itself.
# These are for LOCAL runs only: EAS never sees this file (it is gitignored), so
# a build reads the same names from its profile's `env` block in eas.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Set both to point the client at the local Firestore emulator (apps/functions).
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=

# Set both to point the client at the local Functions emulator (apps/functions).
EXPO_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_HOST=
EXPO_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_PORT=

# Set both to point the client at the local Auth emulator (apps/functions).
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=
